# CLIST API credentials
CLIST_USERNAME=your_clist_username
CLIST_API_KEY=your_clist_api_key

# Database Connection (PostgreSQL connection string)
# e.g., postgresql://user:password@localhost:5432/contests?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contests

# Discord Bot Token & Application
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_APPLICATION_ID=your_discord_application_id

# Default channels/webhooks fallback for single-server setups
DEFAULT_STARTED_CHANNEL_ID=
DEFAULT_DAILY_CHANNEL_ID=
DEFAULT_WEEKLY_CHANNEL_ID=
DEFAULT_WEBHOOK_URL=

# Default server timezone (IANA timezone name)
DEFAULT_TIMEZONE=UTC
